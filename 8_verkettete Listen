import random

class ListElement:
    def __init__(self, value):
        self.value = value
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None
        self._iter_node = None

    def hinten_hinzufuegen(self, value):
        new_elem = ListElement(value)
        if self.head is None:
            self.head = new_elem
            return

        current = self.head
        while current.next is not None:
            current = current.next

        current.next = new_elem

    def __len__(self):
        count = 0
        current = self.head
        while current is not None:
            count += 1
            current = current.next
        return count

    def __iter__(self):
        self._iter_node = self.head
        return self


    def __next__(self):
        if self._iter_node is None:
            raise StopIteration
        value = self._iter_node.value
        self._iter_node = self._iter_node.next
        return value


    def __str__(self):
        string = "["
        current = self.head
        while current is not None:
            string += str(current.value)
            if current.next is not None:
                string += ", "
            current = current.next
        string += "]"
        return string

def main():
    liste = LinkedList()

    for _ in range(10):
        liste.hinten_hinzufuegen(random.randint(1, 100))

    print("Alle Elemente:")
    print(liste)

    print("Länge der Liste:", len(liste))

    print("Iterieren über die Liste mit next():")
    iterator = iter(liste)
    while True:
        try:
            value = next(iterator)
            print(value, end=" ")
        except StopIteration:
            break
    print()

if __name__ == "__main__":
    main()
